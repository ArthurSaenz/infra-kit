{
  "mcpServers": {
    "Playwright": {
      "command": "npx @playwright/mcp@latest"
    },
    "atlassian-mcp-server": {
      "url": "https://mcp.atlassian.com/v1/sse"
    },
    "chrome-devtools": {
      "command": "npx -y chrome-devtools-mcp@latest"
    },
    "infra-kit": {
      "type": "stdio",
      "command": "infra-kit",
      "args": ["mcp"]
    }
  }
}
