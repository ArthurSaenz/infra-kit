              "name": {
                "type": "string",
              },
              "passed": {
                "type": "boolean",
              },
            },
            "required": [
              "name",
              "passed",
              "checks",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "warnCount": {
          "description": "How many checks reported a warning",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "allPassed",
        "warnCount",
        "packages",
      ],
      "type": "object",
    },
