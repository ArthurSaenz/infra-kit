          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "services": {
          "description": "Services requested",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "strippedVars": {
          "description": "Ambient VITE_* names removed from the build env",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "success": {
          "description": "Whether every requested service deployed",
          "type": "boolean",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "environment",
        "accountId",
        "services",
        "deployed",
        "failed",
        "contract",
        "strippedVars",
        "dryRun",
        "success",
      ],
      "type": "object",
    },
    "local deploy-selected": {
