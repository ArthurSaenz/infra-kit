          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "releaseBranch",
        "version",
        "type",
        "success",
      ],
      "type": "object",
    },
    "release deploy-all": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
