      "required": [
        "schemaVersion",
        "command",
        "releaseBranch",
        "version",
        "environment",
        "skipTerraformDeploy",
        "success",
      ],
      "type": "object",
    },
    "release deploy-selected": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "environment": {
          "description": "The environment deployed to",
          "type": "string",
        },
        "releaseBranch": {
          "description": "The release branch that was deployed",
          "type": "string",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "services": {
          "description": "The services that were deployed",
