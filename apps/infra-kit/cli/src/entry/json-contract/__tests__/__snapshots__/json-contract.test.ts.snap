{
  "commands": {
    "audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "allPassed": {
          "description": "Whether every audited package passed all checks (warnings do not fail it)",
