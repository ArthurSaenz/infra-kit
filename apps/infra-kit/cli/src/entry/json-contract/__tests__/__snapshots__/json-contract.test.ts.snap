    "release create": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "createdBranches": {
          "description": "List of created release branch names",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "failedReleases": {
          "description": "List of releases that failed with error messages",
          "items": {
            "additionalProperties": false,
            "properties": {
              "error": {
                "description": "Error message",
                "type": "string",
              },
              "version": {
                "description": "Version number that failed",
                "type": "string",
              },
            },
            "required": [
              "version",
              "error",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "failureCount": {
          "description": "Number of releases that failed",
          "type": "number",
        },
        "releases": {
          "description": "Detailed information for each created release with URLs",
          "items": {
            "additionalProperties": false,
            "properties": {
              "branchName": {
                "description": "Release branch name",
                "type": "string",
              },
              "jiraVersionUrl": {
                "description": "Jira version URL",
                "type": "string",
              },
              "prUrl": {
                "description": "GitHub PR URL",
                "type": "string",
              },
              "releaseDate": {
                "description": "The release date the Jira fix version now carries (yyyy-mm-dd), or null when it has none",
                "type": [
                  "string",
                  "null",
                ],
              },
              "type": {
                "description": "Release type",
                "enum": [
                  "regular",
                  "hotfix",
                ],
                "type": "string",
              },
              "version": {
                "description": "Version number",
                "type": "string",
              },
            },
            "required": [
              "version",
              "type",
              "branchName",
              "prUrl",
              "jiraVersionUrl",
              "releaseDate",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "successCount": {
          "description": "Number of releases created successfully",
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "createdBranches",
        "successCount",
        "failureCount",
        "releases",
        "failedReleases",
      ],
      "type": "object",
    },
    "release deliver": {
