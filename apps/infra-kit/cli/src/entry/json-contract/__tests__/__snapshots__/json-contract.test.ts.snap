    "local deploy-all": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "description": "AWS account the deploy targeted",
          "type": "string",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "contract": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Build contract passed to the scripts",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "deployed": {
          "description": "Services that completed successfully",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "dryRun": {
          "description": "Whether this was a dry run",
