            "type": "string",
          },
          "type": "array",
        },
        "skipTerraformDeploy": {
          "description": "Whether terraform deployment was skipped",
          "type": "boolean",
        },
        "success": {
          "description": "Whether the deployment was successful",
          "type": "boolean",
        },
        "version": {
          "description": "The version that was deployed",
          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "releaseBranch",
        "version",
        "environment",
        "services",
        "skipTerraformDeploy",
        "success",
      ],
      "type": "object",
    },
    "release edit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "description": "Release branch name (e.g. "release/v1.2.5" or "release/checkout-redesign")",
          "type": "string",
        },
        "changed": {
          "description": "Whether anything actually changed",
          "type": "boolean",
        },
        "changedFields": {
          "description": "The fields whose value actually changed",
          "items": {
            "enum": [
              "description",
              "releaseDate",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "jiraVersionUrl": {
          "description": "Jira fix version URL",
          "type": "string",
        },
        "newDescription": {
          "description": "The description after the update",
          "type": "string",
        },
        "newReleaseDate": {
          "description": "The planned release date after the update, or null",
          "type": [
            "string",
            "null",
          ],
        },
        "previousDescription": {
          "description": "The description before the update",
          "type": "string",
        },
        "previousReleaseDate": {
          "description": "The planned release date before the update, or null",
          "type": [
            "string",
            "null",
          ],
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "version": {
          "description": "Release version",
          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "version",
        "branch",
        "jiraVersionUrl",
        "previousDescription",
        "newDescription",
        "previousReleaseDate",
        "newReleaseDate",
        "changedFields",
        "changed",
      ],
      "type": "object",
    },
    "release list": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "count": {
          "description": "Number of release branches",
          "type": "number",
        },
        "releases": {
          "description": "List of all release branches",
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "description": "Jira version description",
                "type": [
                  "string",
                  "null",
                ],
              },
              "releaseDate": {
                "description": "Planned release date of the Jira version (yyyy-mm-dd)",
                "type": [
                  "string",
                  "null",
                ],
              },
              "titleMismatch": {
                "description": "The PR title names a different release type than its base branch",
                "type": "boolean",
              },
              "type": {
                "description": "Release type",
                "enum": [
                  "regular",
                  "hotfix",
                ],
                "type": "string",
              },
              "version": {
                "description": "Release version",
                "type": "string",
              },
            },
            "required": [
              "version",
              "type",
              "description",
              "releaseDate",
              "titleMismatch",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "releases",
        "count",
      ],
      "type": "object",
    },
    "release merge-dev": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "atomicPush": {
          "additionalProperties": false,
          "description": "Outcome of the single all-or-nothing push",
          "properties": {
            "aborted": {
              "type": "boolean",
            },
            "abortedBy": {
              "type": "string",
            },
            "attempted": {
              "type": "boolean",
            },
          },
          "required": [
            "attempted",
            "aborted",
          ],
          "type": "object",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "dryRun": {
          "description": "True when nothing was pushed because this was a plan-only run",
          "type": "boolean",
        },
        "failedBranches": {
          "description": "List of branches that did not merge",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "failedMerges": {
          "description": "Number of branches that did not",
          "type": "number",
        },
        "results": {
          "description": "Per-branch terminal state",
          "items": {
            "additionalProperties": false,
            "properties": {
              "blocked": {
                "additionalProperties": false,
                "description": "Why a \`continue\` run did not commit this resolution",
                "properties": {
                  "code": {
                    "enum": [
                      "unmerged-paths",
                      "markers-remaining",
                      "out-of-scope-edit",
                      "verify-failed",
                      "verify-mutated-tree",
                      "parents-mismatch",
                      "git-too-old",
                      "tree-changed",
                    ],
                    "type": "string",
                  },
                  "detail": {
                    "type": "string",
                  },
                  "paths": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                },
                "required": [
                  "code",
                  "detail",
                ],
                "type": "object",
              },
              "branch": {
                "type": "string",
              },
              "conflictPaths": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "mergeSha": {
                "type": "string",
              },
              "pushed": {
                "type": "boolean",
              },
              "reason": {
                "type": "string",
              },
              "resolution": {
                "additionalProperties": false,
                "description": "The \`keepConflicts\` hand-off for a conflicted branch, or for a clean merge that failed verify (\`verify-failed\`: edit only \`editablePaths\`)",
                "properties": {
                  "baseSha": {
                    "type": "string",
                  },
                  "conflictPaths": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "devSha": {
                    "type": "string",
                  },
                  "editablePaths": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "lockfileOnly": {
                    "type": "boolean",
                  },
                  "rererePreResolved": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "state": {
                    "enum": [
                      "needs-agent",
                      "lockfile-only",
                      "verify-failed",
                      "exists",
                    ],
                    "type": "string",
                  },
                  "worktreePath": {
                    "type": "string",
                  },
                },
                "required": [
                  "worktreePath",
                  "baseSha",
                  "devSha",
                  "conflictPaths",
                  "lockfileOnly",
                  "rererePreResolved",
                  "state",
                ],
                "type": "object",
              },
              "status": {
                "type": "string",
              },
            },
            "required": [
              "branch",
              "status",
              "pushed",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "skipped": {
          "description": "Every discovered release PR that was not a merge candidate, with why. Empty only when nothing was discovered.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "branch": {
                "type": "string",
              },
              "reason": {
                "enum": [
                  "hotfix (targets main)",
                  "title/base mismatch",
                  "open PRs to both dev and main",
                ],
                "type": "string",
              },
            },
            "required": [
              "branch",
              "reason",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "successfulMerges": {
          "description": "Number of branches that reached their desired state",
          "type": "number",
        },
        "totalBranches": {
          "description": "Total number of branches processed",
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "successfulMerges",
        "failedMerges",
        "failedBranches",
        "totalBranches",
        "dryRun",
        "atomicPush",
        "results",
        "skipped",
      ],
      "type": "object",
    },
    "release remove": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "baseBranch": {
          "description": "The branch HEAD was moved to before the local delete",
          "type": "string",
        },
        "branch": {
          "description": "The release branch that was targeted",
          "type": "string",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "jira": {
          "description": ""removed" when the fix version was deleted; "absent" when Jira knows none for this release (the resume path); "skipped" only on the CLI with --skip-jira",
          "enum": [
            "removed",
            "absent",
            "skipped",
          ],
          "type": "string",
        },
        "jiraVersion": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                },
                "name": {
                  "type": "string",
                },
                "url": {
                  "type": "string",
                },
              },
              "required": [
                "id",
                "name",
                "url",
              ],
              "type": "object",
            },
            {
              "type": "null",
            },
          ],
          "description": "The fix version this release owned, captured before removal — the id is the only handle that survives it",
        },
        "localBranch": {
          "description": "Whether a local branch was deleted or none existed",
          "enum": [
            "deleted",
            "absent",
          ],
          "type": "string",
        },
        "localTipSha": {
          "description": "The local tip before deletion — the handle that restores the branch",
          "type": [
            "string",
            "null",
          ],
        },
        "pr": {
          "description": "What happened to the release pull request",
          "enum": [
            "closed",
            "already-closed",
            "absent",
          ],
          "type": "string",
        },
        "prNumber": {
          "description": "The pull request number, or null when none exists",
          "type": [
            "number",
            "null",
          ],
        },
        "remoteBranch": {
          "description": "Whether the origin branch was deleted or none existed",
          "enum": [
            "deleted",
            "absent",
          ],
          "type": "string",
        },
        "remoteTipSha": {
          "description": "The origin tip before deletion",
          "type": [
            "string",
            "null",
          ],
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "version": {
          "description": "The release label (e.g. "1.2.5")",
          "type": "string",
        },
        "worktree": {
          "description": "Whether a git worktree was removed or none existed",
          "enum": [
            "removed",
            "absent",
          ],
          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "branch",
        "version",
        "baseBranch",
        "worktree",
        "pr",
        "prNumber",
        "localBranch",
        "localTipSha",
        "remoteBranch",
        "remoteTipSha",
        "jira",
        "jiraVersion",
      ],
      "type": "object",
    },
    "setup": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "allSucceeded": {
              "description": "Whether no tool failed (a refusal is not a failure)",
              "type": "boolean",
            },
            "changed": {
              "description": "Whether anything was installed or updated",
              "type": "boolean",
            },
            "command": {
              "description": "The grouped command path that ran, e.g. \`release create\`",
              "type": "string",
            },
            "converged": {
              "description": "Whether the dependency step could act at all (false under skipTools)",
              "type": "boolean",
            },
            "init": {
              "description": "One entry per init step, in the order they ran",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "message": {
                    "description": "The same line a human running this would have read",
                    "type": "string",
                  },
                  "outcome": {
                    "description": "What that step did: changed something, found nothing to change, did not run, left a command for a human to run (the message carries it), failed non-fatally, or threw and ended the init half (setup exits 1)",
                    "enum": [
                      "written",
                      "unchanged",
                      "skipped",
                      "manual",
                      "warned",
                      "failed",
                    ],
                    "type": "string",
                  },
                  "step": {
                    "description": "Which init step this reports on",
                    "enum": [
                      "zshrc",
                      "zshenv",
                      "migrations",
                      "user-config",
                      "guidance",
                      "worktrees",
                      "plugin-pointer",
                      "mcp-server",
                      "mcp-proxies",
                      "project-config",
                      "token-perms",
                      "chrome",
                      "shell",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "step",
                  "outcome",
                  "message",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "portlessService": {
              "additionalProperties": false,
              "description": "The portless link, node, and system-service step — run on every setup, never gated on the tool options",
              "properties": {
                "command": {
                  "description": "The sudo \`service install\` command a human has to run; present if and only if service is absent or drifted, null otherwise",
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "link": {
                  "description": "What the ~/.infra-kit/portless link step did",
                  "enum": [
                    "created",
                    "repointed",
                    "unchanged",
                    "skipped-local",
                    "skipped-unresolved",
                    "failed",
                  ],
                  "type": "string",
                },
                "node": {
                  "description": "What the ~/.infra-kit/node step did",
                  "enum": [
                    "created",
                    "refreshed",
                    "unchanged",
                    "skipped-local",
                    "skipped-platform",
                    "failed",
                  ],
                  "type": "string",
                },
                "service": {
                  "description": "The installed portless system service against the link and node: not installed, already running through both, installed but pointing elsewhere, or not judged because portless is not installed",
                  "enum": [
                    "absent",
                    "converged",
                    "drifted",
                    "skipped",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "link",
                "node",
                "service",
                "command",
              ],
              "type": "object",
            },
            "report": {
              "description": "The exact rows of the table printed on stderr; setup exits 1 iff a row is fail",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "description": "Section heading",
                    "type": "string",
                  },
                  "rows": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "message": {
                          "description": "The row message, as printed",
                          "type": "string",
                        },
                        "name": {
                          "description": "Init step, tool id, or portless part",
                          "type": "string",
                        },
                        "notes": {
                          "description": "Lines printed under the row, verbatim: the manual commands, warnings and failures",
                          "items": {
                            "type": "string",
                          },
                          "type": "array",
                        },
                        "status": {
                          "description": "ok: nothing to change; changed: changed something; skipped: did not run; manual: not run by the CLI, the notes hold the command a human runs; warn: advisory problem; fail: failed (setup exits 1)",
                          "enum": [
                            "ok",
                            "changed",
                            "skipped",
                            "manual",
                            "warn",
                            "fail",
                          ],
                          "type": "string",
                        },
                      },
                      "required": [
                        "name",
                        "status",
                        "message",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                },
                "required": [
                  "label",
                  "rows",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "schemaVersion": {
              "const": 1,
              "type": "number",
            },
            "tools": {
              "description": "One result per requested dependency",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "description": "What happened",
                    "enum": [
                      "installed",
                      "updated",
                      "skipped",
                      "refused",
                      "failed",
                    ],
                    "type": "string",
                  },
                  "before": {
                    "additionalProperties": false,
                    "description": "The tool’s state before this run",
                    "properties": {
                      "manager": {
                        "type": "string",
                      },
                      "onPath": {
                        "type": "boolean",
                      },
                      "present": {
                        "type": "boolean",
                      },
                      "version": {
                        "type": [
                          "string",
                          "null",
                        ],
                      },
                    },
                    "required": [
                      "present",
                      "onPath",
                      "version",
                      "manager",
                    ],
                    "type": "object",
                  },
                  "commands": {
                    "description": "The exact commands, one per step — printed even when refused",
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "detail": {
                    "description": "Why, in one line",
                    "type": "string",
                  },
                  "id": {
                    "description": "Dependency id",
                    "type": "string",
                  },
                },
                "required": [
                  "id",
                  "action",
                  "before",
                  "commands",
                  "detail",
                ],
                "type": "object",
              },
              "type": "array",
            },
          },
          "required": [
            "schemaVersion",
            "command",
            "init",
            "tools",
            "portlessService",
            "converged",
            "changed",
            "report",
            "allSucceeded",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "description": "The grouped command path that ran, e.g. \`release create\`",
              "type": "string",
            },
            "outcome": {
              "enum": [
                "ran",
                "not-due",
                "already-running",
              ],
              "type": "string",
            },
            "schemaVersion": {
              "const": 1,
              "type": "number",
            },
          },
          "required": [
            "schemaVersion",
            "command",
            "outcome",
          ],
          "type": "object",
        },
      ],
    },
    "vendor check": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "added": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "fileCount": {
          "type": "number",
        },
        "modified": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "ok": {
          "description": "Whether the vendor tree matches its manifest (false → CI should fail)",
          "type": "boolean",
        },
        "removed": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "status": {
          "enum": [
            "clean",
            "drift",
            "skipped",
            "missing-manifest",
            "unknown-schema",
          ],
          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "status",
        "ok",
        "fileCount",
        "modified",
        "added",
        "removed",
      ],
      "type": "object",
    },
    "vendor sync": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "changed": {
          "type": "boolean",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "failed": {
          "type": "boolean",
        },
        "mode": {
          "enum": [
            "preview",
            "check",
            "applied",
          ],
          "type": "string",
        },
        "report": {
          "description": "The printed report sections",
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
              },
              "rows": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "notes": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "changed",
                        "skipped",
                        "manual",
                        "warn",
                        "fail",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "name",
                    "status",
                    "message",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
            },
            "required": [
              "label",
              "rows",
            ],
            "type": "object",
          },
          "readOnly": true,
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "headSha": {
              "type": [
                "string",
                "null",
              ],
            },
            "name": {
              "type": "string",
            },
            "root": {
              "type": "string",
            },
          },
          "required": [
            "root",
            "name",
            "headSha",
          ],
          "type": "object",
        },
        "targets": {
          "items": {
            "additionalProperties": {},
            "properties": {
              "applied": {
                "type": "boolean",
              },
              "name": {
                "type": "string",
              },
              "root": {
                "type": "string",
              },
              "status": {
                "type": "string",
              },
            },
            "required": [
              "name",
              "root",
              "status",
              "applied",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "mode",
        "source",
        "targets",
        "changed",
        "failed",
        "report",
      ],
      "type": "object",
    },
    "version": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "cwd": {
          "description": "The working directory of this process",
          "type": "string",
        },
        "mainRepoRoot": {
          "description": "The main checkout a linked worktree belongs to (equals repoRoot outside worktrees); null with repoRoot",
          "type": [
            "string",
            "null",
          ],
        },
        "projectDir": {
          "description": "CLAUDE_PROJECT_DIR as Claude Code set it for this process, or null",
          "type": [
            "string",
            "null",
          ],
        },
        "repoRoot": {
          "description": "git toplevel of cwd — the worktree itself in a linked worktree; null when git cannot answer",
          "type": [
            "string",
            "null",
          ],
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "version": {
          "description": "Installed infra-kit CLI version (from package.json)",
          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "version",
        "cwd",
        "repoRoot",
        "mainRepoRoot",
        "projectDir",
      ],
      "type": "object",
    },
    "worktrees add": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "count": {
          "description": "Number of git worktrees created",
          "type": "number",
        },
        "createdWorktrees": {
          "description": "List of created git worktree branches",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "failedWorktrees": {
          "description": "Targets that did not end as a usable worktree: stage "add" = nothing was created; "install" = the worktree exists but \`pnpm install\` failed in it (reason names the path to run it in)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "branch": {
                "type": "string",
              },
              "reason": {
                "type": "string",
              },
              "stage": {
                "enum": [
                  "add",
                  "install",
                ],
                "type": "string",
              },
            },
            "required": [
              "branch",
              "stage",
              "reason",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "features": {
          "description": "Created feature worktrees: source "new" = cut from origin/<base>; "local" / "remote" = an existing branch checked out as-is (base not applied)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "base": {
                "type": "string",
              },
              "branch": {
                "type": "string",
              },
              "source": {
                "enum": [
                  "new",
                  "local",
                  "remote",
                ],
                "type": "string",
              },
            },
            "required": [
              "branch",
              "base",
              "source",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "kind": {
          "description": "Which kind of worktree the run created",
          "enum": [
            "release",
            "feature",
          ],
          "type": "string",
        },
        "orcaHidden": {
          "description": "Created worktrees whose Orca terminals opened on a row the sidebar HIDES (the repo hides external worktrees); fix names the in-app steps to reveal it",
          "items": {
            "additionalProperties": false,
            "properties": {
              "branch": {
                "type": "string",
              },
              "fix": {
                "type": "string",
              },
              "path": {
                "type": "string",
              },
            },
            "required": [
              "branch",
              "path",
              "fix",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "orcaOpened": {
          "description": "Created worktrees that got an Orca terminal tab on a row the sidebar shows, with the layout applied",
          "items": {
            "additionalProperties": false,
            "properties": {
              "branch": {
                "type": "string",
              },
              "layout": {
                "enum": [
                  "full",
                  "single-pane",
                ],
                "type": "string",
              },
            },
            "required": [
              "branch",
              "layout",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "orcaSkipped": {
          "description": "Created worktrees NOT opened in Orca and why: orca_absent / orca_unreachable (config-derived ask, Orca down), orca_worktree_not_selectable (Orca had not scanned the fresh worktree yet), orca_error (code carries the Orca error code)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "branch": {
                "type": "string",
              },
              "code": {
                "type": "string",
              },
              "reason": {
                "enum": [
                  "already_open",
                  "orca_unreachable",
                  "orca_absent",
                  "orca_worktree_not_selectable",
                  "orca_error",
                ],
                "type": "string",
              },
            },
            "required": [
              "branch",
              "reason",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "kind",
        "features",
        "createdWorktrees",
        "count",
        "failedWorktrees",
        "orcaOpened",
        "orcaSkipped",
        "orcaHidden",
      ],
      "type": "object",
    },
    "worktrees list": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "count": {
          "description": "Number of release worktrees",
          "type": "number",
        },
        "features": {
          "description": "Branches of feature worktrees (feature/<name>)",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "worktrees": {
          "description": "Release worktrees with details",
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "description": "Jira version description",
                "type": [
                  "string",
                  "null",
                ],
              },
              "type": {
                "description": "Release type",
                "enum": [
                  "regular",
                  "hotfix",
                ],
                "type": "string",
              },
              "version": {
                "description": "Release version",
                "type": "string",
              },
            },
            "required": [
              "version",
              "type",
              "description",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "worktrees",
        "count",
        "features",
      ],
      "type": "object",
    },
    "worktrees remove": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "count": {
          "description": "Number of git worktrees removed",
          "type": "number",
        },
        "failedWorktrees": {
          "description": "Branches whose worktree could NOT be removed (git refused, or an unsweepable leftover remained)",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "handedOff": {
          "additionalProperties": false,
          "description": "--self only: the worktree whose removal now runs in an Orca tab of the main checkout",
          "properties": {
            "branch": {
              "type": "string",
            },
            "terminal": {
              "type": "string",
            },
            "worktreePath": {
              "type": "string",
            },
          },
          "required": [
            "branch",
            "worktreePath",
            "terminal",
          ],
          "type": "object",
        },
        "removedWorktrees": {
          "description": "List of removed git worktree branches",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "removedWorktrees",
        "failedWorktrees",
        "count",
      ],
      "type": "object",
    },
    "worktrees sync": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "count": {
          "description": "Number of worktrees removed during sync",
          "type": "number",
        },
        "failedWorktrees": {
          "description": "Branches whose worktree could NOT be removed (git refused, or an unsweepable leftover remained)",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "removedWorktrees": {
          "description": "List of removed worktree branches",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "removedWorktrees",
        "failedWorktrees",
        "count",
      ],
      "type": "object",
    },
  },
  "refusal": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": {},
    "properties": {
      "command": {
        "description": "The grouped command path that ran, e.g. \`release create\`",
        "type": "string",
      },
      "schemaVersion": {
        "const": 1,
        "type": "number",
      },
      "status": {
        "enum": [
          "confirmation_required",
          "argument_required",
          "partial_failure",
          "refused",
          "error",
        ],
        "type": "string",
      },
    },
    "required": [
      "schemaVersion",
      "command",
      "status",
    ],
    "type": "object",
  },
}
`;
