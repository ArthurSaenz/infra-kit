    "dev-status": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "active": {
          "description": "True when at least one dev-context fragment exists on disk (an infra-kit dev session has apps registered). False means no active dev session was found — this is a clean result, NOT an error.",
          "type": "boolean",
        },
        "apps": {
          "description": "One entry per dev-context fragment on disk, sorted by app name. Empty when no dev session is active.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "ageSeconds": {
                "description": "Seconds since the fragment was last written on disk. A large value with live:false means a stale/abandoned fragment.",
                "type": "number",
              },
              "alias": {
                "description": "Registered portless hostname for the app.",
                "type": "string",
              },
              "app": {
                "description": "App folder name (the fragment filename without .json).",
                "type": "string",
              },
              "env": {
                "description": "INFRA_KIT_ENV the dev session runs with — where its UIs proxy cloud routes. Null when none was loaded, or the fragment predates the field.",
                "type": [
                  "string",
                  "null",
                ],
              },
              "fragmentMtime": {
                "description": "ISO 8601 filesystem mtime of the fragment file — the AUTHORITATIVE freshness signal.",
                "type": "string",
              },
              "live": {
                "description": "Whether a TCP connection to the app port succeeds RIGHT NOW (a real engine liveness probe, not an inference). A fresh fragment with live:false is a crashed or killed dev server whose fragment was not cleaned up.",
                "type": "boolean",
              },
              "origin": {
                "description": "Authoritative local origin the vite helper proxies to for this app.",
                "type": "string",
              },
              "package": {
                "description": "The app package name the vite helper reads to decide a local route.",
                "type": "string",
              },
              "pid": {
                "description": "PID of the dev-server process that wrote the fragment (ownership / staleness metadata).",
                "type": "number",
              },
              "port": {
                "description": "The actual bound port the dev server is listening on.",
                "type": "number",
              },
              "release": {
                "description": "Release slug the runner recorded for this worktree.",
                "type": "string",
              },
              "writtenAt": {
                "description": "ISO 8601 time the runner self-reported writing the fragment (writer clock — may be wrong; prefer fragmentMtime). Null when the fragment did not record it.",
                "type": [
                  "string",
                  "null",
                ],
              },
            },
            "required": [
              "app",
              "package",
              "port",
              "pid",
              "alias",
              "origin",
              "release",
              "env",
              "writtenAt",
              "fragmentMtime",
              "ageSeconds",
              "live",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "contextDir": {
          "description": "The RESOLVED dev-context fragment directory — found by searching UPWARD from the working directory. This is where the read looked, NOT proof anything is there: when no fragment directory exists the resolver derives one from an up-tree \`.infra-kit\`, so this can name a path (even under $HOME) that was never written to. Check contextDirExists before drawing any conclusion from it. Null when no \`.infra-kit\` anchor exists up-tree at all.",
          "type": [
            "string",
            "null",
          ],
        },
        "contextDirExists": {
          "description": "Whether contextDir actually exists on disk. False with a non-null contextDir means the path was DERIVED, not read — the usual state in a repo where \`infra-kit dev\` has never run. Distinguishes "looked and found nothing" from "had nowhere to look".",
          "type": "boolean",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "active",
        "contextDir",
        "contextDirExists",
        "apps",
      ],
      "type": "object",
    },
    "doctor": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "allPassed": {
          "description": "Whether no check failed (warnings and skips do not count)",
          "type": "boolean",
        },
        "checks": {
          "description": "List of all check results",
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "additionalProperties": false,
                "description": "Probe facts about an external dependency. Never a fix: no action, no commands",
                "properties": {
                  "manager": {
                    "description": "Which package manager owns this install, read from its resolved path",
                    "type": "string",
                  },
                  "onPath": {
                    "description": "The binary resolves on PATH",
                    "type": "boolean",
                  },
                  "present": {
                    "description": "The tool is installed somewhere findable — on PATH or not",
                    "type": "boolean",
                  },
                  "version": {
                    "description": "The version the tool reported, or null",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                },
                "required": [
                  "manager",
                  "version",
                  "present",
                  "onPath",
                ],
                "type": "object",
              },
              "fixable": {
                "description": "Whether \`infra-kit doctor --fix\` repairs this row",
                "type": "boolean",
              },
              "message": {
                "description": "Details about the check result",
                "type": "string",
              },
              "name": {
                "description": "Name of the check",
                "type": "string",
              },
              "status": {
                "description": "Check result; warn is advisory and never fails the run; skip is not evaluated; the message says why; never a failure",
                "enum": [
                  "pass",
                  "fail",
                  "warn",
                  "skip",
                ],
                "type": "string",
              },
            },
            "required": [
              "name",
              "status",
              "message",
              "fixable",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "cliVersion": {
          "description": "Version of the infra-kit CLI that produced this report",
          "type": "string",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "checks",
        "allPassed",
        "cliVersion",
      ],
      "type": "object",
    },
    "e2e": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "annotated": {
          "description": "Per spec file, the tests that passed or skipped while asserting little, as Playwright ran them; empty unless report is collected.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "fail": {
                "description": "test.fail — green only while the bug it registers exists.",
                "type": "number",
              },
              "file": {
                "type": "string",
              },
              "fixme": {
                "description": "test.fixme — skipped as unfinished.",
                "type": "number",
              },
              "skip": {
                "description": "test.skip, declared or called at runtime, conditional ones included.",
                "type": "number",
              },
            },
            "required": [
              "file",
              "fail",
              "fixme",
              "skip",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "app": {
          "type": "string",
        },
        "baseUrl": {
          "description": "The URL the run was pointed at: the local alias, or the deployed URL.",
          "type": "string",
        },
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "deployedUrlEnv": {
          "description": "The target’s variable holding its deployed URL; a cloud run reads it. Null when it declares none.",
          "type": [
            "string",
            "null",
          ],
        },
        "devCommand": {
          "description": "Local runs with nothing served: the dev command the Playwright config starts, and stops after.",
          "type": [
            "string",
            "null",
          ],
        },
        "env": {
          "description": "INFRA_KIT_ENV of this process; the env a cloud run targets.",
          "type": [
            "string",
            "null",
          ],
        },
        "errors": {
          "description": "Run-level errors with no test to blame (config, global setup, a spec that fails to import), ANSI stripped and truncated; empty unless report is collected.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "exitCode": {
          "description": "Playwright’s exit code; null when it did not run.",
          "type": [
            "number",
            "null",
          ],
        },
        "failures": {
          "description": "One entry per test and project that failed, needed a retry, or failed in some repeat; empty unless report is collected.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "error": {
                "description": "The failure message, ANSI stripped, truncated to 2000 characters.",
                "type": [
                  "string",
                  "null",
                ],
              },
              "failedRuns": {
                "description": "How many of those runs failed.",
                "type": "number",
              },
              "file": {
                "type": "string",
              },
              "line": {
                "type": [
                  "number",
                  "null",
                ],
              },
              "project": {
                "type": "string",
              },
              "retry": {
                "description": "The retry index of the failed attempt reported here.",
                "type": "number",
              },
              "runs": {
                "description": "How many times the test ran in this project — its --repeat-each repeats.",
                "type": "number",
              },
              "status": {
                "description": "flaky: failed, then passed on a retry or in another --repeat-each repeat.",
                "enum": [
                  "unexpected",
                  "flaky",
                ],
                "type": "string",
              },
              "title": {
                "description": "Describe path and test title, joined with ›.",
                "type": "string",
              },
              "tracePath": {
                "description": "The failed attempt’s trace.zip; open with \`playwright show-trace\`.",
                "type": [
                  "string",
                  "null",
                ],
              },
            },
            "required": [
              "title",
              "file",
              "line",
              "project",
              "status",
              "retry",
              "runs",
              "failedRuns",
              "error",
              "tracePath",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "localUrl": {
          "description": "This worktree’s address for the target, whether or not anything serves it.",
          "type": "string",
        },
        "mode": {
          "description": "local (default): this worktree’s dev server. cloud (--cloud): the deployed app at env.",
          "enum": [
            "local",
            "cloud",
          ],
          "type": "string",
        },
        "outputDir": {
          "description": "Where this run’s traces and attachments live — its own directory, so a later run cannot delete them. Null unless report is collected or unavailable.",
          "type": [
            "string",
            "null",
          ],
        },
        "packageName": {
          "type": "string",
        },
        "playwrightArgs": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "ran": {
          "description": "False for --dry-run.",
          "type": "boolean",
        },
        "release": {
          "description": "This worktree’s release slug — the first label of every local alias.",
          "type": "string",
        },
        "report": {
          "description": "Per-test results: collected from Playwright’s JSON reporter under --json/agent mode; caller-reporter when playwrightArgs carried its own --reporter; unavailable when the run wrote no readable report; off otherwise.",
          "enum": [
            "off",
            "caller-reporter",
            "unavailable",
            "collected",
          ],
          "type": "string",
        },
        "routes": {
          "description": "Served local UI runs only: the dev proxy’s route-by-route local/cloud split, local backends probed.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "live": {
                "type": [
                  "boolean",
                  "null",
                ],
              },
              "packageName": {
                "type": "string",
              },
              "path": {
                "type": "string",
              },
              "source": {
                "enum": [
                  "local",
                  "cloud",
                ],
                "type": "string",
              },
              "target": {
                "type": [
                  "string",
                  "null",
                ],
              },
            },
            "required": [
              "path",
              "packageName",
              "source",
              "target",
              "live",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "served": {
          "description": "Whether this worktree’s dev server already served the target when the run began.",
          "type": "boolean",
        },
        "servedEnv": {
          "description": "Served local runs: the INFRA_KIT_ENV the running dev session recorded — where its cloud routes go. Null when nothing served the target or the session recorded none. A local run refuses when it differs from env.",
          "type": [
            "string",
            "null",
          ],
        },
        "summary": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "expected": {
                  "type": "number",
                },
                "flaky": {
                  "type": "number",
                },
                "repeatFlaky": {
                  "type": "number",
                },
                "skipped": {
                  "type": "number",
                },
                "unexpected": {
                  "type": "number",
                },
              },
              "required": [
                "expected",
                "unexpected",
                "flaky",
                "skipped",
                "repeatFlaky",
              ],
              "type": "object",
            },
            {
              "type": "null",
            },
          ],
          "description": "Playwright’s counts by outcome, one per run (each --repeat-each repeat counts), plus repeatFlaky: tests that passed in some repeats and failed in others. Null unless report is collected.",
        },
        "target": {
          "description": "The package under test, \`<app>/ui\` or \`<app>/api\`.",
          "type": "string",
        },
        "testsDir": {
          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "app",
        "testsDir",
        "target",
        "packageName",
        "mode",
        "baseUrl",
        "deployedUrlEnv",
        "release",
        "env",
        "servedEnv",
        "localUrl",
        "served",
        "devCommand",
        "routes",
        "playwrightArgs",
        "ran",
        "exitCode",
        "report",
        "outputDir",
        "summary",
        "failures",
        "annotated",
        "errors",
      ],
      "type": "object",
    },
    "env-clear": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "filePath": {
          "description": "Path to the file that must be sourced to apply",
          "type": "string",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "unsetStatements": {
          "description": "Unset statements generated",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "variableCount": {
          "description": "Number of variables cleared",
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "filePath",
        "variableCount",
        "unsetStatements",
      ],
      "type": "object",
    },
    "env-list": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "configs": {
          "description": "Every environment name known to this project",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "defaultEnv": {
          "description": "The configured "defaultEnv" — what env-load takes when no config is named; null when unset",
          "type": [
            "string",
            "null",
          ],
        },
        "project": {
          "description": "Detected Doppler project name",
          "type": "string",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "tokens": {
          "description": "Per-environment token presence — never the token value",
          "items": {
            "additionalProperties": false,
            "properties": {
              "env": {
                "description": "Environment / Doppler config name",
                "type": "string",
              },
              "hasToken": {
                "description": "Whether a service token resolves locally for this environment",
                "type": "boolean",
              },
              "source": {
                "description": "Where we learned this environment exists — a workflow declaration, or a token we hold",
                "enum": [
                  "gh-workflow",
                  "token-only",
                ],
                "type": "string",
              },
            },
            "required": [
              "env",
              "source",
              "hasToken",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "project",
        "defaultEnv",
        "configs",
        "tokens",
      ],
      "type": "object",
    },
    "env-load": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "config": {
          "description": "Doppler config name",
          "type": "string",
        },
        "configSource": {
          "description": "How the config was chosen: passed as "config", the configured "defaultEnv", or the terminal picker",
          "enum": [
            "argument",
            "default",
            "picker",
          ],
          "type": "string",
        },
        "filePath": {
          "description": "Path to the file that must be sourced to apply variables",
          "type": "string",
        },
        "project": {
          "description": "Doppler project name",
          "type": "string",
        },
        "schemaVersion": {
          "const": 1,
          "type": "number",
        },
        "sessionId": {
          "description": "The INFRA_KIT_SESSION the file was written for; null when the process had no session",
          "type": [
            "string",
            "null",
          ],
        },
        "variableCount": {
          "description": "Number of variables loaded",
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "filePath",
        "variableCount",
        "project",
        "config",
        "configSource",
        "sessionId",
      ],
      "type": "object",
    },
    "env-status": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
