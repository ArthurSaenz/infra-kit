          "type": [
            "string",
            "null",
          ],
        },
        "sessionLoadedCount": {
          "description": "Number of cached vars active in the current session",
          "type": "number",
        },
        "sessionProject": {
          "description": "Doppler project name of the loaded session",
          "type": [
            "string",
            "null",
          ],
        },
        "sessionTotalCount": {
          "description": "Total number of cached var names",
          "type": "number",
        },
      },
      "required": [
        "schemaVersion",
        "command",
        "sessionId",
        "sessionLoadedCount",
        "sessionTotalCount",
        "sessionConfig",
        "sessionProject",
        "sessionLoadedAt",
      ],
      "type": "object",
    },
    "env-token-list": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
