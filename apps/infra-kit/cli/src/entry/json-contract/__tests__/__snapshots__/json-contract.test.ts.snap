        "command": {
          "description": "The grouped command path that ran, e.g. \`release create\`",
          "type": "string",
        },
        "excluded": {
          "description": "On an \`all\` run: the repo-relative packages infra-kit.json \`audit.exclude\` skipped",
          "items": {
            "type": "string",
